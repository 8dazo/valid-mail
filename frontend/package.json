{
  "name": "weme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "format": "prettier --write src e2e *.ts *.json",
    "format:check": "prettier --check src e2e *.ts *.json"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@noble/hashes": "2.4.0",
    "change-case": "5.4.4",
    "cronstrue": "3.32.0",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "fast-xml-parser": "5.11.2",
    "ipaddr.js": "2.5.0",
    "jsonrepair": "3.15.0",
    "jwt-decode": "4.0.0",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.55.0",
    "marked": "18.1.1",
    "motion": "14.1.0",
    "nanoid": "6.0.2",
    "papaparse": "5.7.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "validator": "13.15.35",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/validator": "^13.15.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
